{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,

    // Choose the order of the modules
    "modules-left": ["sway/workspaces","sway/window"],
    // "modules-right": ["wireplumber", "network", "cpu", "memory", "clock", "tray"],
    "modules-right": ["group/drawer", "clock", "tray"],

    // Modules configuration
    "tray": {
        "spacing": 10
    },
    "clock": {
        "interval": 1,
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %B %d, %Y (%T)}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cc241d'><b>{}</b></span>",
                "days": "<span color='#bdae93'><b>{}</b></span>",
                "weekdays": "<span color='#b8bb26'><b>{}</b></span>",
                "today": "<span color='#fe8019'><b><u>{}</u></b></span>"
            }
        },
        "actions":  {
            "on-click-right": "mode"
        }
    },
    "group/drawer": {
        "drawer": {
            "children-class": "hw-tray",
            "click-to-reveal": false,
            "transition-duration": 100,
            "transition-left-to-right": false
        },
        "modules": ["wireplumber#sink", "cpu", "memory", "network", "wireplumber#source"],
        "orientation": "horizontal"
    },
    "cpu": {
        "interval": 1,
        "format": "{usage:2}% ",
        "states": {
            "low": 0,
            "med": 40,
            "high": 60,
            "crit": 85
        },
        "tooltip-format": "load: {load:<4}",
        "on-click": "ghostty -e btop --preset 1"
    },
    "memory": {
        "interval": 1,
        "format": "{used:.2f} GiB ",
        "on-click": "ghostty -e btop"
    },
    "network": {
        "interval": 1,
        "format-wifi": "{signalStrength}% ",
        "format-ethernet": "󰈀",
        "tooltip-format-wifi": "{essid}\non {ifname}\n  with {ipaddr}{cidr}\n  via {gwaddr}",
        "tooltip-format-ethernet": "ethernet\n  on {ifname}\n  with {ipaddr}/{cidr}\n  via {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "󱞐",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected"
    },
    "wireplumber#sink": {
        "node-type": "Audio/Sink",
        "max-volume": 150,
        "format": "{icon}{volume: 4}%",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "ssw choose"
    },
    "wireplumber#source": {
        "node-type": "Audio/Source",
        "format": "{icon}{volume: 4}%",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon}",
        "format-muted": "",
        "format-icons": [""]
    },
    "custom/hw": {
        "format": "Hardware"
    }
}
