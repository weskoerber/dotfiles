# `man 5 sway`

bindsym Super+Return exec ghostty +new-window
bindsym Super+f exec zen-browser
bindsym Super+d exec fuzzel --list-executables-in-path

bindsym Alt+Shift+e exec swaynag -t warning -m 'Do you really want to exit sway?' -B 'Yes' 'swaymsg exit'

bindsym Super+z splith
bindsym Super+v splitv

bindsym Super+s layout stacking
bindsym Super+w layout tabbed
bindsym Super+e layout toggle split

focus_wrapping no
floating_modifier Alt normal

mode "resize" {
    bindsym h resize shrink width 3ppt
    bindsym j resize shrink height 3ppt
    bindsym k resize grow height 1ppt
    bindsym l resize grow width 1ppt

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym Mod4+r mode "resize"

# Audio
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume -l 1.5 @DEFAULT_SINK@ 5%-
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Mic
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_SOURCE@ toggle # This opens fuzzel for some reason?

bar {
    swaybar_command waybar
}

include ~/.config/sway/*.conf

# vim: ft=swayconfig
