#!/bin/sh

# set -eux -o pipefail

#      ______    ______   __       __
#     /      \  /      \ |  \  _  |  \
#    |  $$$$$$\|  $$$$$$\| $$ / \ | $$
#    | $$___\$$| $$___\$$| $$/  $\| $$       ______  ______  ______
#     \$$    \  \$$    \ | $$  $$$\ $$      |      \|      \|      \
#     _\$$$$$$\ _\$$$$$$\| $$ $$\$$\$$       \$$$$$$ \$$$$$$ \$$$$$$
#    |  \__| $$|  \__| $$| $$$$  \$$$$
#     \$$    $$ \$$    $$| $$$    \$$$
#      \$$$$$$   \$$$$$$  \$$      \$$
#
#
#
#      ______   __            __               ______   __       __  __    __                __
#     /      \ |  \          |  \             /      \ |  \  _  |  \|  \  |  \              |  \
#    |  $$$$$$\ \$$ _______  | $$   __       |  $$$$$$\| $$ / \ | $$ \$$ _| $$_     _______ | $$____    ______    ______
#    | $$___\$$|  \|       \ | $$  /  \      | $$___\$$| $$/  $\| $$|  \|   $$ \   /       \| $$    \  /      \  /      \
#     \$$    \ | $$| $$$$$$$\| $$_/  $$       \$$    \ | $$  $$$\ $$| $$ \$$$$$$  |  $$$$$$$| $$$$$$$\|  $$$$$$\|  $$$$$$\
#     _\$$$$$$\| $$| $$  | $$| $$   $$        _\$$$$$$\| $$ $$\$$\$$| $$  | $$ __ | $$      | $$  | $$| $$    $$| $$   \$$
#    |  \__| $$| $$| $$  | $$| $$$$$$\       |  \__| $$| $$$$  \$$$$| $$  | $$|  \| $$_____ | $$  | $$| $$$$$$$$| $$
#     \$$    $$| $$| $$  | $$| $$  \$$\       \$$    $$| $$$    \$$$| $$   \$$  $$ \$$     \| $$  | $$ \$$     \| $$
#      \$$$$$$  \$$ \$$   \$$ \$$   \$$        \$$$$$$  \$$      \$$ \$$    \$$$$   \$$$$$$$ \$$   \$$  \$$$$$$$ \$$


# CLI flags
o_sources=0
cmd='list'

# wpctl output -- global variable used by functions
output="$(wpctl status)"
readonly output

parse_output() {
    audio=0
    audio_sinks=0

    key='Sinks'

    if [ $o_sources -eq 1 ]; then
        key='Sources'
    fi

    IFS=$'\n'; for line in $output; do
        # find the 'Audio' section
        if [ $audio -eq 0 ]; then
            case "$line" in
                Audio) audio=1; continue;;
                *) continue ;;
            esac
        fi

        # find the 'Sinks' section
        if [ $audio_sinks -eq 0 ]; then
            case "$line" in
                " ├─ $key:") audio_sinks=1; continue ;;
                *) continue ;;
            esac
        fi

        case "$line" in
            ' │'*) ;;
            *) break ;;
        esac

        # skip empty lines
        if [ ${#line} -lt 5 ]; then
            continue
        fi

        echo "$line" | sed -E 's/^\s+│\s+\**\s+([0-9]+)\.\s+(.*)\s+\[vol:.*/\1:\2/'
    done
}

list() {
    parse_output | awk -F: '{print $2}'
}

choose() {
    parse_output | grep "$1" | awk -F: '{print $1}'
}

# parse CLI
while [ -n "$1" ]; do
    case "$1" in
        --sources) o_sources=1; shift ;;
        list) cmd='list'; shift ;;
        choose) cmd='choose'; shift ;;
        *) echo "unknown option: '$1'" >&2 && exit 2 ;;
    esac
done

if [ $cmd = 'list' ]; then
    list
    exit 0
elif [ $cmd = 'choose' ]; then
    id="$(choose "$(list | fuzzel --dmenu --no-exit-on-keyboard-focus-loss)" | awk -F: '{print $1}')"
    wpctl set-default "$id"
    exit 0
fi
